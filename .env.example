# Copy to .env and fill in. Never commit .env.
# AI for wording chat answers. Default: the on-premise model in the `llm` container (docker-compose).
# Deterministic, document-quoting answers are used whenever the model is unavailable.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=http://llm:11434/v1
LLM_MODEL=qwen2.5:1.5b-instruct
LLM_API_KEY=
# Alternative: LLM_PROVIDER=anthropic with ANTHROPIC_API_KEY=... and LLM_MODEL=claude-sonnet-5
ANTHROPIC_API_KEY=
# Set to 1 to also let the LLM extract extra rules from uploads (off by default).
LLM_EXTRACT=0
# LLM call timeout in seconds (default 30; CPU inference on a local model is slow).
LLM_TIMEOUT=30
# Password for all seeded demo users.
DEMO_PASSWORD=verity-demo
# Set to 1 when served over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE=0
# Set to 1 to wipe and reseed the database on startup.
VERITY_RESET=0
